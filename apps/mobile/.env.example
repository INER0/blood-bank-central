# Physical phone or emulator on the same network:
# Replace YOUR_COMPUTER_IP with the computer's IPv4 address from `ipconfig`.
EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_IP:4000/api

# Android Studio emulator alternative (when testing only in the emulator):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api

# Web or iOS simulator running on this computer:
# EXPO_PUBLIC_API_URL=http://localhost:4000/api
